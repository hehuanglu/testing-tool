{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "runtime-safety/1.0"
    },
    "planHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "growth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "integer",
          "minimum": 1
        },
        "docker": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "host",
        "docker"
      ]
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "owned-synthetic"
        },
        "evidenceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classification",
        "evidenceSha256",
        "evidenceRef"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "addons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "uniqueItems": true
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "name",
              "type",
              "enabled",
              "sha256"
            ]
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "enabled"
            ]
          },
          "uniqueItems": true
        },
        "inputVectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "addons",
        "scripts",
        "rules",
        "inputVectors"
      ]
    },
    "sampleSeconds": {
      "const": 5
    },
    "reserveBytes": {
      "const": 2147483648
    },
    "ramHeadroomBytes": {
      "const": 4294967296
    },
    "stopSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "runtimePins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "planHash",
    "growth",
    "calibration",
    "policy",
    "sampleSeconds",
    "reserveBytes",
    "ramHeadroomBytes",
    "stopSeconds",
    "runtimePins",
    "sourceDigest"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
