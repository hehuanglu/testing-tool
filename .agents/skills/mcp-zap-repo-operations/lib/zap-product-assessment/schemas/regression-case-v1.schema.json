{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zap-assessment/regression-case-v1.schema.json",
  "title": "ZAP regression case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "id",
    "profile",
    "fixture",
    "requests",
    "requireResponses",
    "expect"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "caseId"],
          "properties": {
            "kind": {"const": "synthetic-demo"},
            "path": {"type": "string", "minLength": 1},
            "caseId": {"$ref": "#/$defs/slug"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "assessmentId",
            "caseId",
            "criterionIds",
            "planRevision",
            "planDigest",
            "evidence"
          ],
          "properties": {
            "kind": {"const": "assessment-run-v3"},
            "assessmentId": {"type": "string", "minLength": 1},
            "caseId": {"type": "string", "minLength": 1},
            "criterionIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "planRevision": {"type": "string", "minLength": 1},
            "planDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId", "resultPath", "sha256"],
                "properties": {
                  "operationId": {"type": "string", "minLength": 1},
                  "resultPath": {"type": "string", "pattern": "^/"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            }
          }
        }
      ]
    },
    "id": {"$ref": "#/$defs/slug"},
    "profile": {"const": "passive-http-v1"},
    "fixture": {"const": "csp-demo"},
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "method": {"const": "GET"},
          "path": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "requireResponses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mediaType"],
      "properties": {
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "mediaType": {"type": "string", "minLength": 1}
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "alertRef", "presentOn", "absentOn", "requireNonEmptyCspOn"],
      "properties": {
        "basis": {"type": "string", "minLength": 1},
        "alertRef": {"const": "10038-1"},
        "presentOn": {"$ref": "#/$defs/slug"},
        "absentOn": {"$ref": "#/$defs/slug"},
        "requireNonEmptyCspOn": {"$ref": "#/$defs/slug"}
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
  }
}
