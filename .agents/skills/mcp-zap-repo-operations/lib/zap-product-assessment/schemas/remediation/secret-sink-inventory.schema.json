{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "secret-sink-readiness/1.0"
    },
    "readinessOnly": {
      "const": true
    },
    "g3Status": {
      "const": "blocked"
    },
    "secretValuesIncluded": {
      "const": false
    },
    "allowedZones": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalSource": {
          "type": "string",
          "minLength": 1
        },
        "isolatedMemory": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "externalSource",
        "isolatedMemory"
      ]
    },
    "requiredLifecycle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "encodings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "encodingLimits": {
      "type": "string",
      "minLength": 1
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "native",
              "delegated",
              "browser",
              "business"
            ]
          },
          "status": {
            "const": "blocked"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "ownerWorkPackage": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "mode",
          "status",
          "reason",
          "ownerWorkPackage"
        ]
      },
      "uniqueItems": true
    },
    "sinks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sinkId": {
            "type": "string",
            "minLength": 1
          },
          "requiredFor": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "native",
                "delegated",
                "browser",
                "business"
              ]
            },
            "uniqueItems": true
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "accessMethod": {
            "type": "string",
            "minLength": 1
          },
          "auditStatus": {
            "const": "unproven"
          },
          "seededControlStatus": {
            "const": "not_run"
          },
          "lifecycleStatus": {
            "const": "not_run"
          },
          "historicalObservation": {
            "type": "string",
            "minLength": 1
          },
          "nextProof": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sinkId",
          "requiredFor",
          "locations",
          "accessMethod",
          "auditStatus",
          "seededControlStatus",
          "lifecycleStatus",
          "historicalObservation",
          "nextProof"
        ]
      },
      "uniqueItems": true
    },
    "publicationPolicy": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "readinessOnly",
    "g3Status",
    "secretValuesIncluded",
    "allowedZones",
    "requiredLifecycle",
    "encodings",
    "encodingLimits",
    "modes",
    "sinks",
    "publicationPolicy"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
