{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unresolved source facts, never executable discovery",
  "type": "object",
  "required": [
    "sources",
    "operations",
    "auth",
    "fixtures",
    "conflicts",
    "gaps",
    "schemaVersion",
    "stage",
    "productLocation",
    "backendOnly",
    "environment",
    "binding",
    "origins",
    "policies"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "location",
          "sha256",
          "observedAt",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source",
              "openapi",
              "deployment",
              "runtime",
              "ui",
              "traffic",
              "authority"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedAt": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "pathTemplate",
          "protected",
          "semantics",
          "input",
          "evidenceRefs",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "pathTemplate": {
            "type": "string",
            "minLength": 1
          },
          "protected": {
            "type": "boolean"
          },
          "semantics": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object"
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "auth": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "loginOperationId",
            "usernameField",
            "passwordField",
            "tokenPointer",
            "headerName",
            "headerPrefix",
            "identity",
            "credentialRef",
            "evidenceRefs",
            "confidence"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "loginOperationId": {
              "type": "string",
              "minLength": 1
            },
            "usernameField": {
              "type": "string",
              "minLength": 1
            },
            "passwordField": {
              "type": "string",
              "minLength": 1
            },
            "tokenPointer": {
              "type": "string",
              "minLength": 1
            },
            "headerName": {
              "type": "string",
              "minLength": 1
            },
            "headerPrefix": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "type": "object",
              "required": [
                "operationId",
                "subjectPointer",
                "actorSource",
                "expectedStatus",
                "contentType"
              ],
              "properties": {
                "operationId": {
                  "type": "string",
                  "minLength": 1
                },
                "subjectPointer": {
                  "type": "string",
                  "minLength": 1
                },
                "actorSource": {
                  "type": "object",
                  "required": [
                    "operationId",
                    "subjectPointer"
                  ],
                  "properties": {
                    "operationId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subjectPointer": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "expectedStatus": {
                  "const": 200
                },
                "contentType": {
                  "const": "application/json"
                }
              },
              "additionalProperties": false
            },
            "credentialRef": {
              "type": "string",
              "minLength": 1
            },
            "evidenceRefs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operationIds",
          "preparation",
          "ownership",
          "postconditions",
          "evidenceRefs",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operationIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preparation": {
            "type": "string",
            "minLength": 1
          },
          "ownership": {
            "type": "string",
            "minLength": 1
          },
          "postconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "blocking",
          "evidenceRefs"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "description",
          "evidenceRefs"
        ],
        "properties": {
          "status": {
            "enum": [
              "unknown",
              "not-observed",
              "unsupported",
              "failed",
              "not-run"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "schemaVersion": {
      "const": "product-source-candidate/1.0"
    },
    "stage": {
      "const": "source-only"
    },
    "productLocation": {
      "type": "string",
      "minLength": 1
    },
    "backendOnly": {
      "type": "boolean"
    },
    "environment": {
      "type": "null"
    },
    "binding": {
      "type": "null"
    },
    "origins": {
      "type": "array",
      "maxItems": 0
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "hypothesis",
              "accepted",
              "conflicted"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "authObservations": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
