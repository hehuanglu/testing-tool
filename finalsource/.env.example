# Loopback HTTPS port used to open the application in a browser.
APP_PORT=8080

# MySQL application user/database. Change MYSQL_PASSWORD before starting.
MYSQL_DATABASE=vibe_security
MYSQL_USER=vibe_security
MYSQL_PASSWORD=change-this-local-database-password

# Use at least 32 random characters. Never commit finalsource/.env.
JWT_SECRET=change-this-to-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=3600
JWT_ISSUER=security-vibe-coding
JWT_AUDIENCE=security-vibe-coding-web
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
ACCOUNT_NUMBER_ENCRYPTION_KEY_BASE64=
ACCOUNT_NUMBER_HMAC_KEY_BASE64=
ACCOUNT_NUMBER_KEY_VERSION=1
