{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zap-assessment/regression-export-v1.schema.json",
  "title": "ZAP regression export input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ci"],
  "properties": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "caseId"],
          "properties": {
            "kind": {"const": "synthetic-demo"},
            "path": {"type": "string", "minLength": 1},
            "caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "commitSha", "path", "caseId"],
          "properties": {
            "kind": {"const": "product-qualification"},
            "repository": {"type": "string", "pattern": "^https://github[.]com/[^/]+/[^/]+[.]git$"},
            "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "path": {"type": "string", "minLength": 1},
            "caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
          }
        }
      ]
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "fixture", "requests", "requireResponses", "expect"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "profile": {"enum": ["passive-http-v1", "anti-framing-http-v1"]},
        "fixture": {"enum": ["csp-demo", "byteme-v1"]},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "repository", "commitSha"],
          "properties": {
            "adapter": {"const": "byteme-v1"},
            "repository": {"type": "string", "pattern": "^https://github[.]com/[^/]+/[^/]+[.]git$"},
            "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "method", "path"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
              "method": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "origin": {"enum": ["product", "detector-control"]}
            }
          }
        },
        "requireResponses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "mediaType"],
          "properties": {
            "status": {"type": "integer", "minimum": 100, "maximum": 599},
            "mediaType": {"type": "string", "minLength": 1}
          }
        },
        "expect": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["basis", "alertRef", "presentOn", "absentOn", "requireNonEmptyCspOn"],
              "properties": {
                "basis": {"type": "string", "minLength": 1},
                "alertRef": {"type": "string", "minLength": 1},
                "presentOn": {"type": "string", "minLength": 1},
                "absentOn": {"type": "string", "minLength": 1},
                "requireNonEmptyCspOn": {"type": "string", "minLength": 1}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["basis", "evaluateOn", "trustedAncestors", "assumption"],
              "properties": {
                "basis": {"type": "string", "minLength": 1},
                "evaluateOn": {"type": "string", "minLength": 1},
                "trustedAncestors": {"const": ["'self'"]},
                "assumption": {"const": "modern-user-agent-csp3-html-xfo"}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"fixture": {"const": "byteme-v1"}}, "required": ["fixture"]},
          "then": {
            "required": ["target"],
            "properties": {
              "requests": {"items": {"required": ["origin"]}}
            }
          },
          "else": {"not": {"required": ["target"]}}
        }
      ]
    }
  }
}
