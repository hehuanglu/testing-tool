{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "be-authenticated-research/1.0 plan",
  "type": "object",
  "required": ["assuranceProfile", "secretPersistenceAccepted", "environment", "authority", "targetBinding", "jobStore", "coordinator", "origin", "actorSubject", "operations", "ruleIds", "limits"],
  "properties": {
    "assuranceProfile": {"const": "be-authenticated-research/1.0"},
    "secretPersistenceAccepted": {"const": true},
    "environment": {"const": "finalsource-zap-test"},
    "authority": {"type": "object", "required": ["fixtureActiveAuthorized", "source"], "properties": {"fixtureActiveAuthorized": {"const": true}, "source": {"type": "string", "minLength": 1}}},
    "targetBinding": {"type": "object", "required": ["containerId", "imageId", "startedAt", "networkId", "address"]},
    "jobStore": {"const": "in-memory"},
    "coordinator": {"const": "single-node"},
    "origin": {"const": "http://backend:3000"},
    "actorSubject": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["method", "path"], "properties": {"method": {"enum": ["GET", "POST", "PUT", "DELETE"]}, "path": {"type": "string", "pattern": "^/api/v1/"}, "fixtureOwned": {"type": "boolean"}}}},
    "ruleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "limits": {"type": "object", "required": ["monitorIntervalSeconds", "stopDeadlineSeconds", "hostReserveBytes", "operationTimeoutSeconds"], "properties": {"monitorIntervalSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 2}, "stopDeadlineSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}, "hostReserveBytes": {"type": "integer", "minimum": 2147483648}, "operationTimeoutSeconds": {"type": "number", "minimum": 1, "maximum": 180}}}
  }
}
