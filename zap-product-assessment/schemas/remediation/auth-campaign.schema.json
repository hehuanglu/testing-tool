{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "assessmentId", "planSha256", "scope", "sourcePins", "cases", "caseCount", "allExpectedOutcomes", "gateDecision", "securityVerdict", "securityApproval", "gates", "missingSecretProof"],
  "properties": {
    "schemaVersion": {"const": "w5-auth-campaign/1.0"},
    "assessmentId": {"type": "string", "minLength": 1},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"const": "synthetic-loopback-development"},
    "sourcePins": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["caseId", "status"], "properties": {"caseId": {"type": "string"}, "status": {"enum": ["pass", "fail", "blocked"]}}}},
    "caseCount": {"type": "integer", "minimum": 1},
    "allExpectedOutcomes": {"type": "boolean"},
    "gateDecision": {"const": "block"},
    "securityVerdict": {"const": "inconclusive"},
    "securityApproval": {"const": false},
    "gates": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [
      {"type": "object", "required": ["gateId", "status"], "properties": {"gateId": {"const": "G4-development-synthetic"}, "status": {"enum": ["pass", "fail"]}}},
      {"type": "object", "required": ["gateId", "status"], "properties": {"gateId": {"const": "G3-auditor-development"}, "status": {"enum": ["pass", "fail"]}}},
      {"type": "object", "required": ["gateId", "status"], "properties": {"gateId": {"const": "G3-delegated-operational"}, "status": {"const": "blocked"}}},
      {"type": "object", "required": ["gateId", "status"], "properties": {"gateId": {"const": "G4-finalsource-product"}, "status": {"const": "blocked"}}}
    ]},
    "missingSecretProof": {"type": "array", "minItems": 143, "items": {"type": "object", "required": ["sinkId", "lifecycle", "status", "reason"], "properties": {"sinkId": {"type": "string"}, "lifecycle": {"type": "string"}, "status": {"const": "blocked"}, "reason": {"type": "string"}}}}
  }
}
