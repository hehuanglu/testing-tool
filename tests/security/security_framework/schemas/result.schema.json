{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone security suite evidence and verdict",
  "type": "object",
  "required": ["schemaVersion", "suite", "scenario", "runId", "executionEnvironment", "inputSha256", "evidence", "checks", "verdict", "exitCode", "decisiveChecks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "scenario": { "$ref": "#/$defs/id" },
    "runId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "executionEnvironment": { "enum": ["local", "github-actions"] },
    "scannerImage": { "type": "string", "pattern": "@sha256:[a-f0-9]{64}$" },
    "inputSha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "evidence": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" },
      "additionalProperties": { "$ref": "#/$defs/observation" }
    },
    "checks": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/check" }
    },
    "verdict": { "$ref": "#/$defs/verdict" },
    "exitCode": { "enum": [0, 1, 2, 3] },
    "decisiveChecks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/reason" }
    }
  },
  "allOf": [
    { "if": { "properties": { "verdict": { "const": "PASS" } } }, "then": { "properties": { "exitCode": { "const": 0 } } } },
    { "if": { "properties": { "verdict": { "const": "FAIL" } } }, "then": { "properties": { "exitCode": { "const": 1 } } } },
    { "if": { "properties": { "verdict": { "const": "ERROR" } } }, "then": { "properties": { "exitCode": { "const": 2 } } } },
    { "if": { "properties": { "verdict": { "const": "BLOCKED" } } }, "then": { "properties": { "exitCode": { "const": 3 } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "verdict": { "enum": ["PASS", "FAIL", "ERROR", "BLOCKED"] },
    "reason": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$" },
    "observation": {
      "type": "object",
      "required": ["producer", "data"],
      "additionalProperties": false,
      "properties": {
        "producer": { "enum": ["application-identity", "automation-framework", "capability-boundary", "fixture", "runner", "suite-assertion", "zap-report"] },
        "data": { "oneOf": [{ "type": "object", "minProperties": 1 }, { "type": "array", "minItems": 1 }] }
      }
    },
    "check": {
      "type": "object",
      "required": ["verdict", "reason", "objectiveId", "cwe", "method", "specification", "authProfile", "expected", "evidenceRefs"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "$ref": "#/$defs/verdict" },
        "reason": { "$ref": "#/$defs/reason" },
        "objectiveId": { "$ref": "#/$defs/id" },
        "cwe": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^CWE-[1-9][0-9]*$" }
        },
        "method": {
          "enum": ["passive-dast", "authenticated-passive-dast", "authorization", "application-assertion", "automation-framework", "authenticated-active-dast"]
        },
        "specification": { "type": "string", "pattern": "^specifications/.+\\.md$" },
        "authProfile": { "$ref": "#/$defs/id" },
        "expected": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^#/evidence/[A-Za-z][A-Za-z0-9_-]{0,127}$" }
        }
      }
    }
  }
}
